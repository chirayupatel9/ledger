# Generate unique local secrets with: node deploy/setup.mjs
APP_ORIGIN=http://localhost:5800
SITE_ADDRESS=:80
POSTGRES_PASSWORD=
AUTH_SECRET=
MAIL_DELIVERY_ENABLED=true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Ledger <noreply@ledger.local>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Scheduled backups (written to ./backups as scheduled-*.dump; copy them off this machine)
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
BACKUP_UID=1000
BACKUP_GID=1000
# Optional second copy on a locally attached drive (folder must exist on the drive; see README)
# COMPOSE_FILE=compose.yaml:deploy/compose.backup-drive.yaml
# BACKUP_DRIVE=/mnt/backup
# BACKUP_DRIVE_FOLDER=ledger
# BACKUP_DRIVE_KEEP=60
